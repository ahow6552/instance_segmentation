 y="480"/><mxPoint x="1530" y="480"/><mxPoint x="1530" y="725"/><mxPoint x="645" y="725"/></Array></mxGeometry></mxCell><mxCell id="pipe-65" value="&lt;b&gt;本次結果（Result/20261023_010153_unet_instance，best epoch 34）&lt;/b&gt;：val mask mAP 0.233｜&lt;b&gt;test mask mAP 0.236&lt;/b&gt;、AP50 0.348、AP75 0.253｜AP small 0.034 / medium 0.193 / large 0.306&lt;br&gt;每類別 mask AP：reptiles 0.449、human 0.383、robots 0.333、garbage 0.276、mollusk 0.267、fish 0.247、ruins 0.171、arthropoda 0.142、corals 0.075、plants 0.020" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1480" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Model architecture" id="arch"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arch-1" value="&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;3 × 384 × 512" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-2" value="&lt;b&gt;Stem&lt;/b&gt;：Conv7×7 s2 + BN + ReLU&lt;br&gt;64 × 192 × 256（1/2）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-3" value="&lt;b&gt;MaxPool + layer1&lt;/b&gt;（3 × BasicBlock）&lt;br&gt;64 × 96 × 128（1/4）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-4" value="&lt;b&gt;layer2&lt;/b&gt;（4 × BasicBlock）&lt;br&gt;128 × 48 × 64（1/8）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-5" value="&lt;b&gt;layer3&lt;/b&gt;（6 × BasicBlock）&lt;br&gt;256 × 24 × 32（1/16）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-6" value="&lt;b&gt;layer4&lt;/b&gt;（3 × BasicBlock）&lt;br&gt;512 × 12 × 16（1/32）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="620" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-7" value="&lt;b&gt;Block 1&lt;/b&gt;：Up×2 ⊕ layer3&lt;br&gt;768 → 256　|　256 × 24 × 32" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="500" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-8" value="&lt;b&gt;Block 2&lt;/b&gt;：Up×2 ⊕ layer2&lt;br&gt;384 → 128　|　128 × 48 × 64" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="400" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-9" value="&lt;b&gt;Block 3&lt;/b&gt;：Up×2 ⊕ layer1&lt;br&gt;192 → 64　|　64 × 96 × 128" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-10" value="&lt;b&gt;Block 4&lt;/b&gt;：Up×2 ⊕ stem&lt;br&gt;128 → 64　|　64 × 192 × 256" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-11" value="&lt;b&gt;Block 5&lt;/b&gt;：Up×2（無 skip）&lt;br&gt;64 → 64　|　64 × 384 × 512" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="280" height="64" as="geometry"/></mxCell><mxCell id="arch-12" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-1" target="arch-2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-13" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-2" target="arch-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-14" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-3" target="arch-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-15" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-4" target="arch-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-16" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="arch-5" target="arch-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-17" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="arch-6" target="arch-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-18" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-7" target="arch-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-19" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-8" target="arch-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-20" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-9" target="arch-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-21" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-10" target="arch-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-22" value="skip（concat）" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="arch-2" target="arch-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-23" value="skip（concat）" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="arch-3" target="arch-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-24" value="skip（concat）" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="arch-4" target="arch-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-25" value="skip（concat）" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;dashed=1;strokeColor=#82b366;" edge="1" parent="1" source="arch-5" target="arch-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-26" value="&lt;b&gt;Semantic head&lt;/b&gt;&lt;br&gt;Conv3×3(64)+BN+ReLU → Conv1×1&lt;br&gt;11 × 384 × 512（logits）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1150" y="20" width="330" height="70" as="geometry"/></mxCell><mxCell id="arch-27" value="&lt;b&gt;Center head&lt;/b&gt;&lt;br&gt;Conv3×3(64)+BN+ReLU → Conv1×1&lt;br&gt;1 × 384 × 512（heatmap）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1150" y="110" width="330" height="70" as="geometry"/></mxCell><mxCell id="arch-28" value="&lt;b&gt;Offset head&lt;/b&gt;&lt;br&gt;Conv3×3(64)+BN+ReLU → Conv1×1&lt;br&gt;2 × 384 × 512，×32 → pixel (dy, dx)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1150" y="200" width="330" height="70" as="geometry"/></mxCell><mxCell id="arch-29" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-11" target="arch-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-30" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-11" target="arch-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-31" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-11" target="arch-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-32" value="torch.cat → 14 × 384 × 512&lt;br&gt;split_outputs 拆回三份" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1150" y="300" width="330" height="50" as="geometry"/></mxCell><mxCell id="arch-33" value="" style="endArrow=classic;html=1;rounded=0;fontSize=12;labelBackgroundColor=default;" edge="1" parent="1" source="arch-28" target="arch-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-34" value="&lt;b style='font-size:20px'&gt;U-Net instance segmentation 架構&lt;/b&gt;&lt;br&gt;輸入 512×384（W×H），shape 以 C × H × W 表示" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="60" as="geometry"/></mxCell><mxCell id="arch-35" value="&lt;b&gt;說明&lt;/b&gt;&lt;br&gt;• Encoder（藍）：ResNet34，ImageNet 預訓練，21.3M 參數&lt;br&gt;• Decoder（綠）：每個 block = nearest Up×2 → concat skip → 2 × (Conv3×3 + BN + ReLU)，3.3M 參數&lt;br&gt;• Heads（橘）：三個獨立的小 head（每個約 37k 參數），取代 smp 原本的 segmentation_head&lt;br&gt;• Block 中的「768 → 256」= concat 後的 channel → 輸出 channel&lt;br&gt;• 總參數約 24.7M" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1150" y="400" width="380" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>